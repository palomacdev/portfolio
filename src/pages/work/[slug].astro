---
import Base from '../../layouts/Base.astro'; import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}))}; const {project}=Astro.props;
---
<Base title={project.name+' — Case Study · Paloma Cordeiro'} description={project.summary}><article><header class="case-hero shell"><a class="back" href="/work">← All work</a><p class="kicker">{project.eyebrow}</p><h1>{project.name}</h1><p class="case-title">{project.headline}</p><div class="meta"><div><span>Status</span><strong>{project.status}</strong></div><div><span>Proof</span><strong>{project.proof}</strong></div><div><span>Stack</span><strong>{project.stack.join(' · ')}</strong></div></div>{project.links&&<div class="actions">{project.links.map(l=><a class="button" href={l.href}>{l.label} ↗</a>)}</div>}</header><section class="case-body shell"><aside><p class="kicker">The problem</p></aside><div><h2>Start with the problem, not the stack.</h2><p class="body-big">{project.problem}</p></div></section><section class="case-body shell"><aside><p class="kicker">Architecture</p></aside><div><div class="flow">{project.architecture.map((x,i)=><><span>{x}</span>{i<project.architecture.length-1&&<b>→</b>}</>)}</div></div></section><section class="case-body shell"><aside><p class="kicker">Key decisions</p></aside><div class="decisions">{project.decisions.map((d,i)=><div><span>0{i+1}</span><p>{d}</p></div>)}</div></section><section class="case-body shell"><aside><p class="kicker">What comes next</p></aside><div><h2>Built to evolve.</h2><p class="body-big">{project.next}</p></div></section></article><section class="cta shell"><p class="kicker">Need this kind of engineering?</p><h2>Let's turn the messy part into a system.</h2><a class="button light" href="mailto:palomacordeiro2009@hotmail.com">Start a conversation ↗</a></section></Base>